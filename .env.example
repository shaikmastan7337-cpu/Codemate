# CodeMate Student - Environment Variables Template
# Copy this file to .env.local for local development. DO NOT commit .env files to Git.

# --- Frontend Environment Variables (Vite) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# --- Server-side / Edge Functions Environment Variables (Supabase / Backend) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
CODE_EXECUTION_API_KEY=your-sandbox-execution-api-key
